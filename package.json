{
  "name": "gcm-ai",
  "version": "0.1.0",
  "description": "AI-powered Git commit message generator following Conventional Commits",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "gcm": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "git",
    "commit",
    "conventional-commits",
    "ai",
    "openai",
    "anthropic",
    "cli",
    "developer-tools",
    "productivity"
  ],
  "author": "Samir Cabrera",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samcab28/GCM-AI.git"
  },
  "homepage": "https://github.com/samcab28/GCM-AI",
  "bugs": {
    "url": "https://github.com/samcab28/GCM-AI/issues"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}